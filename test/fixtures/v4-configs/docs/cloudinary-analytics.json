            "customData4": "Hello world",
            "customData5": "false"
          }
        }
      },
      "readyCallback": false,
      "elements": [
        {
          "tag": "video",
          "attributes": {
            "id": "player-custom-data-plain-object",
            "playsinline": "",
            "controls": "",
            "muted": "",
            "autoplay": "",
            "class": "cld-video-player",
            "width": "500"
          },
          "sources": []
        }
      ],
      "calls": [
        {
          "call": "source",
          "args": [
            "elephants"
          ]
        }
      ]
    },
    {
      "factory": "videoPlayer",
      "target": "player-custom-data-function",
