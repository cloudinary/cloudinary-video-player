{
  "page": "docs/cloudinary-analytics.html",
  "players": [
    {
      "factory": "videoPlayer",
      "target": "player",
      "options": {
        "cloudName": "demo",
        "secure": true,
        "cloudinaryAnalytics": true
      },
      "readyCallback": false,
      "elements": [
        {
          "tag": "video",
          "attributes": {
            "id": "player",
            "playsinline": "",
            "controls": "",
            "muted": "",
            "autoplay": "",
            "class": "cld-video-player",
            "width": "500"
          },
          "sources": []
        }
      ],
      "calls": [
        {
          "call": "source",
          "args": [
            "elephants"
          ]
        }
      ]
    },
    {
      "factory": "videoPlayer",
      "target": "adpPlayer",
      "options": {
        "cloudName": "demo",
        "secure": true,
        "cloudinaryAnalytics": true
      },
