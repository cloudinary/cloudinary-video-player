{
  "page": "docs/force-hls-subtitles-ios.html",
  "players": [
    {
      "factory": "videoPlayer",
      "target": "player",
      "options": {
        "cloud_name": "demo",
        "html5": {
          "vhs": {
            "overrideNative": true
          }
        }
      },
      "readyCallback": false,
      "elements": [
        {
          "tag": "video",
          "attributes": {
            "id": "player",
            "controls": "",
            "muted": "",
            "autoplay": "",
            "class": "cld-video-player",
            "crossorigin": "anonymous",
            "width": "500"
          },
          "sources": []
        }
      ],
      "calls": [
        {
          "call": "source",
          "args": [
            "sea_turtle",
            {
              "sourceTypes": [
                "hls"
              ],
              "transformation": {
                "streaming_profile": "hd"
              },
              "textTracks": {
                "captions": {
                  "label": "English(captions)",
                  "language": "en",
                  "default": true,
                  "url": "https://res.cloudinary.com/demo/raw/upload/outdoors.vtt"
                },
                "subtitles": [
                  {
                    "label": "English",
                    "language": "en",
                    "url": "https://res.cloudinary.com/demo/raw/upload/outdoors.vtt"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
