// Ring rules (plan.md, Structure Decision) and the Video.js @internal ban (R-02).
// Overrides replace the base options, so every override repeats the `paths` list (S-6).
// No --type-aware: it needs oxlint-tsgolint, which is not approved.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@videojs/html",
            "importNames": [
              "definePlayerFeature",
              "PlayerExtension",
              "defineSlice",
              "extensionContext",
              "mediaContext",
              "createMediaAttachMixin"
            ],
            "message": "Video.js @internal API: use public APIs only (research.md R-02)."
          },
          {
            "name": "@videojs/core",
            "importNames": [
              "definePlayerFeature",
              "PlayerExtension",
              "defineSlice",
              "extensionContext",
              "mediaContext",
              "createMediaAttachMixin"
            ],
            "message": "Video.js @internal API: use public APIs only (research.md R-02)."
          },
          {
            "name": "@videojs/core/dom",
            "importNames": [
              "definePlayerFeature",
              "PlayerExtension",
              "defineSlice",
              "extensionContext",
              "mediaContext",
              "createMediaAttachMixin"
            ],
            "message": "Video.js @internal API: use public APIs only (research.md R-02)."
          },
          {
            "name": "@videojs/store",
            "importNames": [
              "definePlayerFeature",
              "PlayerExtension",
              "defineSlice",
              "extensionContext",
              "mediaContext",
              "createMediaAttachMixin"
            ],
            "message": "Video.js @internal API: use public APIs only (research.md R-02)."
          }
        ]
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "property": "innerHTML",
        "message": "Render user strings with textContent (constitution)."
      },
      {
        "property": "outerHTML",
        "message": "Render user strings with textContent (constitution)."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/core/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@videojs/html",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              },
              {
                "name": "@videojs/core",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              },
              {
                "name": "@videojs/core/dom",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              },
              {
                "name": "@videojs/store",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)(shell|player|features|entries)(/|$)",
                "message": "core imports nothing from the other rings."
              },
              {
                "regex": "^@videojs/",
                "message": "core and shell have no Video.js imports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shell/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@videojs/html",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              },
              {
                "name": "@videojs/core",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              },
              {
                "name": "@videojs/core/dom",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              },
              {
                "name": "@videojs/store",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              }
            ],
            "patterns": [
              {
                "regex": "(^|/)(player|features|entries)(/|$)",
                "message": "shell imports only core; the layer comes in through its loader parameter."
              },
              {
                "regex": "^@videojs/",
                "message": "core and shell have no Video.js imports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@videojs/html",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              },
              {
                "name": "@videojs/core",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              },
              {
                "name": "@videojs/core/dom",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              },
              {
                "name": "@videojs/store",
                "importNames": [
                  "definePlayerFeature",
                  "PlayerExtension",
                  "defineSlice",
                  "extensionContext",
                  "mediaContext",
                  "createMediaAttachMixin"
                ],
                "message": "Video.js @internal API: use public APIs only (research.md R-02)."
              }
            ],
            "patterns": [
              {
                "regex": "^\\.\\./[^.]",
                "message": "features never import each other."
              },
              {
                "regex": "(^|/)(shell|entries|features)(/|$)",
                "message": "features import only core and player/context."
              },
              {
                "group": [
                  "**/player",
                  "**/player/**",
                  "!**/player/context.js"
                ],
                "message": "features import only core and player/context."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "scripts/url-parity/**",
    "scripts/v4-configs/**",
    "dist/**",
    "test/fixtures/**"
  ]
}
