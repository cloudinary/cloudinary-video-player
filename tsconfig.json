{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "cloudinary-video-player": [
        "./src/entries/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "examples",
    "*.config.ts"
  ],
  "exclude": [
    "test/fixtures"
  ]
}
