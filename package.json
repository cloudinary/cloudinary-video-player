{
  "name": "cloudinary-video-player",
  "version": "5.0.0-alpha.0",
  "description": "Cloudinary Video Player",
  "author": "Cloudinary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudinary/cloudinary-video-player.git"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cld-video-player.min.css": "./dist/cld-video-player.min.css",
    "./schema.json": "./dist/schema.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown && node scripts/finish-dist.mjs",
    "dev": "vite --config examples/vite.config.ts",
    "build:examples": "vite build --config examples/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint -c .oxlintrc.json src test examples scripts && node scripts/check-test-waits.mjs",
    "lint:package": "publint --pack npm && attw --pack . --profile esm-only --exclude-entrypoints ./cld-video-player.min.css",
    "schema": "node scripts/build-schema.mjs",
    "schema:check": "node scripts/build-schema.mjs --check",
    "size": "size-limit",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e:smoke": "playwright test --project=chrome --project=firefox --project=webkit",
    "test:e2e": "E2E_FULL=1 playwright test --project=chrome --project=firefox --project=webkit",
    "test:e2e:preview": "playwright test --project=preview",
    "commitlint": "commitlint --edit"
  },
  "keywords": [
    "dash",
    "hls",
    "html5",
    "player",
    "video",
    "videojs",
    "cloudinary"
  ],
  "dependencies": {
    "@videojs/dash-video": "10.7.0",
    "@videojs/hlsjs-video": "10.7.0",
    "@videojs/html": "10.7.0",
    "cloudinary-video-analytics": "1.8.2",
    "cloudinary-video-player-profiles": "1.3.0"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1",
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.1",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "@tsdown/css": "0.23.7",
    "@vitest/browser-playwright": "5.1.2",
    "conventional-changelog-angular": "^8.1.0",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-recommended-bump": "^11.2.0",
    "husky": "^9.1.7",
    "oxlint": "1.95.0",
    "publint": "0.3.25",
    "semver": "^7.7.3",
    "size-limit": "14.3.0",
    "ts-json-schema-generator": "2.10.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
